# =========================
# TELEGRAM BOT SOZLAMALARI
# =========================
# BotFather dan olingan bot token
TELEGRAM_BOT_TOKEN=your_bot_token_here

# InitData amal qilish muddati (soniyalarda, standart: 86400 = 24 soat)
TELEGRAM_AUTH_MAX_AGE=86400

# =========================
# SUPABASE SOZLAMALARI
# =========================
# Supabase Project Settings > API dan oling
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# =========================
# PRISMA / DATABASE
# =========================
# Supabase Project Settings > Database > Connection String > URI
# Transaction Mode (pooler) — Next.js/Vercel uchun
DATABASE_URL="postgresql://postgres.your-project:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection — Prisma migrations uchun
DIRECT_URL="postgresql://postgres.your-project:[password]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# =========================
# ILOVANING URL
# =========================
# Production URL (Vercel da deploy qilgandan so'ng)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# =========================
# DEVELOPMENT SOZLAMALARI
# =========================
# Development rejimida Telegram auth ni o'tkazib yuborish (true/false)
SKIP_TELEGRAM_AUTH=true
